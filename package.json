{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "types:check": "vue-tsc --noEmit",
    "types:watch": "vue-tsc --noEmit --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "syn": "node scripts/ai-config-sync.mjs",
    "syn:check": "node scripts/ai-config-sync.mjs --check",
    "syn:opencode": "node scripts/ai-config-opencode-sync.mjs",
    "syn:opencode:check": "node scripts/ai-config-opencode-sync.mjs --check",
    "verify": "npm run syn:check && npm run format:check && npm run types:check",
    "fix": "npm run format && npm run syn",
    "module:make": "node scripts/module-make.mjs",
    "module:done": "npm run fix && npm run types:check && npm run build && composer gate",
    "module:codegen": "composer codegen && npm run module:done",
    "test:module": "php artisan test --compact --filter=",
    "dev:async": "concurrently -k -n vite,tsc -c \"#93c5fd,#c4b5fd\" \"npm:dev\" \"npm:types:watch\""
  },
  "devDependencies": {
    "@pinia/colada-devtools": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/google.maps": "^3.66.8",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "concurrently": "^10.0.3",
    "fontaine": "^0.8.2",
    "laravel-vite-plugin": "^3.2.0",
    "prettier": "^3.9.9",
    "prettier-plugin-blade": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "volt-vue": "^0.0.0-alpha.4",
    "vue-tsc": "^3.3.11"
  },
  "optionalDependencies": {
    "@laravel/multiplex": "^0.4.1"
  },
  "dependencies": {
    "@fullcalendar/vue3": "^7.1.0",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@inertiajs/vite": "^3.7.1",
    "@inertiajs/vue3": "^3.7.1",
    "@pinia/colada": "^1.4.6",
    "@primevue/forms": "^5.0.1",
    "@primevue/icons": "^5.0.1",
    "@tresjs/core": "^5.10.0",
    "@vueuse/core": "^15.0.0",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "laravel-echo": "^2.5.0",
    "libphonenumber-js": "^1.13.14",
    "motion-v": "^2.5.0",
    "pinia": "^4.0.3",
    "primeicons": "^8.0.2",
    "primevue": "^5.0.1",
    "pusher-js": "^8.6.0",
    "signature_pad": "^5.1.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-primeui": "^0.6.1",
    "temporal-polyfill": "^1.0.5",
    "three": "^0.186.1",
    "vue": "^3.5.43",
    "vue-advanced-cropper": "^2.8.9",
    "zod": "^4.6.5"
  }
}
