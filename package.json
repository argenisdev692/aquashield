{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "types:check": "tsc --noEmit",
    "types:watch": "tsc --noEmit --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "syn": "node scripts/ai-config-sync.mjs",
    "syn:check": "node scripts/ai-config-sync.mjs --check",
    "syn:opencode": "node scripts/ai-config-opencode-sync.mjs",
    "syn:opencode:check": "node scripts/ai-config-opencode-sync.mjs --check",
    "verify": "npm run syn:check && npm run format:check && npm run types:check",
    "fix": "npm run format && npm run syn",
    "module:make": "node scripts/module-make.mjs",
    "module:done": "npm run fix && npm run types:check && npm run build && composer gate",
    "module:codegen": "composer codegen && npm run module:done",
    "test:module": "php artisan test --compact --filter=",
    "dev:async": "concurrently -k -n vite,tsc -c \"#93c5fd,#c4b5fd\" \"npm:dev\" \"npm:types:watch\""
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/google.maps": "^3.66.8",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.3",
    "laravel-vite-plugin": "^3.2.0",
    "prettier": "^3.9.9",
    "prettier-plugin-blade": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "optionalDependencies": {
    "@laravel/multiplex": "^0.4.1"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fullcalendar/react": "^7.1.5",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@inertiajs/react": "^3.11.0",
    "@inertiajs/vite": "^3.11.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-table": "^9.3.1",
    "@tresjs/core": "^5.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.14.0",
    "laravel-echo": "^2.5.0",
    "libphonenumber-js": "^1.13.14",
    "lucide-react": "^1.74.0",
    "pusher-js": "^8.6.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.5",
    "shadcn": "^4.23.0",
    "signature_pad": "^5.1.4",
    "tailwind-merge": "^3.7.0",
    "temporal-polyfill": "^1.0.5",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  }
}
