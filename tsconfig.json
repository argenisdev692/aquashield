{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "paths": {
      "@/volt/*": ["./src/volt/*"],
      "@/pages/*": ["./resources/js/Pages/*"],
      "@/layouts/*": ["./resources/js/Layouts/*"],
      "@/*": ["./resources/js/*"]
    }
  },
  "include": ["resources/js/**/*.ts", "resources/js/**/*.vue", "src/**/*.ts", "src/**/*.vue"],
  "exclude": ["node_modules", "public", "vendor"]
}
