{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "laravel/laravel",
  "type": "project",
  "description": "The skeleton application for the Laravel framework.",
  "keywords": [
    "laravel",
    "framework"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "bacon/bacon-qr-code": "^3.1",
    "barryvdh/laravel-dompdf": "^3.1",
    "bepsvpt/secure-headers": "^9.1",
    "dedoc/scramble": "^0.13.45",
    "inertiajs/inertia-laravel": "3.4.0",
    "intervention/image": "^4.3",
    "laravel/ai": "^1.0",
    "laravel/fortify": "^1.40",
    "laravel/framework": "^13.17",
    "laravel/sanctum": "^4.0",
    "laravel/socialite": "^5.31",
    "laravel/telescope": "^5.25",
    "laravel/tinker": "^3.0",
    "league/flysystem-aws-s3-v3": "^3.35",
    "phpoffice/phpword": "^1.4",
    "pragmarx/google2fa-laravel": "^3.0",
    "propaganistas/laravel-phone": "^6.0",
    "ramsey/uuid": "^4.9",
    "resend/resend-laravel": "^1.5",
    "spatie/laravel-activitylog": "^5.1",
    "spatie/laravel-backup": "^10.3",
    "spatie/laravel-cookie-consent": "^3.5",
    "spatie/laravel-csp": "^3.29",
    "spatie/laravel-data": "^4.23",
    "spatie/laravel-google-calendar": "^3.8",
    "spatie/laravel-honeypot": "^4.7",
    "spatie/laravel-medialibrary": "^11.23",
    "spatie/laravel-one-time-passwords": "^1.1",
    "spatie/laravel-permission": "^8.3",
    "spatie/laravel-sitemap": "^8.2",
    "spatie/laravel-typescript-transformer": "^3.3",
    "spatie/simple-excel": "^3.10"
  },
  "require-dev": {
    "barryvdh/laravel-debugbar": "^4.4",
    "barryvdh/laravel-ide-helper": "^3.7",
    "beyondcode/laravel-query-detector": "^2.3",
    "driftingly/rector-laravel": "^2.6",
    "fakerphp/faker": "^1.23",
    "larastan/larastan": "^3.12",
    "laravel/doctor": "^0.1.0",
    "laravel/pail": "^1.2.5",
    "laravel/pao": "^1.0.6",
    "laravel/pint": "^1.32",
    "laravel/vet": "^0.2.1",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "pestphp/pest": "^5.2",
    "pestphp/pest-plugin-arch": "5.0",
    "pestphp/pest-plugin-laravel": "^5.0",
    "rector/rector": "^2.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Modules\\": "src/Modules/",
      "Shared\\": "src/Shared/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "setup": [
      "composer install",
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php artisan key:generate",
      "@php artisan migrate --force",
      "npm install --ignore-scripts",
      "npm run build"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"npm run dev\" --names='server,queue,vite'"
    ],
    "test": [
      "@php artisan config:clear --ansi @no_additional_args",
      "@lint",
      "@php artisan test"
    ],
    "analyse": [
      "@php vendor/bin/phpstan analyse --memory-limit=1G"
    ],
    "pint": [
      "@php vendor/bin/pint"
    ],
    "pint:test": [
      "@php vendor/bin/pint --blade --test"
    ],
    "lint": [
      "@analyse",
      "@pint:test"
    ],
    "doctor": [
      "@php artisan doctor --except=Laravel\\Doctor\\Diagnostics\\SqliteDatabaseExists"
    ],
    "doctor:all": [
      "@php artisan doctor"
    ],
    "vet": [
      "@php vendor/bin/vet --no-interaction"
    ],
    "check": [
      "@php artisan config:clear --ansi @no_additional_args",
      "@lint",
      "@php artisan test"
    ],
    "codegen": [
      "@php artisan ide-helper:models --write",
      "@pint",
      "@php artisan typescript:transform",
      "@php artisan scramble:clear",
      "@php artisan scramble:export",
      "@php artisan scramble:cache"
    ],
    "gate": [
      "@php artisan config:clear --ansi @no_additional_args",
      "@doctor",
      "@check"
    ],
    "update:safe": [
      "@php vendor/bin/vet"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ],
    "pre-package-uninstall": [
      "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true,
      "laravel/vet": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
