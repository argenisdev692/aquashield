APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Comma-separated previous APP_KEY values during key rotation (config/app.php).
# APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Railway (or any TLS-terminating proxy): use the public https origin.
# The app trusts the platform proxy and forces HTTPS in production, so @vite
# and asset() emit https:// URLs. Never set this to http:// in production.
# APP_URL=https://your-app.up.railway.app

# Comma-separated CIDRs of the platform edge. `*` trusts any proxy; set the
# Railway edge ranges in production (or ensure the edge overwrites
# X-Forwarded-For) so IP throttles and consent evidence cannot be spoofed.
TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
# PRODUCTION: LOG_CHANNEL=json (structured output with request_id context)
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# The local app refuses migrate:fresh/db:wipe/db:seed when DB_HOST is remote.
# Set true only for a deliberate operation against a shared database.
DB_ALLOW_REMOTE_DESTRUCTIVE=false
# `backup:run --only-db` needs pg_dump on PATH. Windows/Herd does not bundle it:
# point this at the client bin dir, e.g. C:/Program Files/PostgreSQL/17/bin.
# On Railway the image installs postgresql-client-17; leave this unset unless
# pg_dump is outside PATH (then /usr/lib/postgresql/17/bin).
# DB_DUMP_BINARY_PATH=

# Local/testing demo users only. UserSeeder returns immediately outside
# local/testing and when this is empty. Never set it in a shared environment.
SEED_USER_PASSWORD=

# First demo SUPER_ADMIN and the owner of the local CompanyData profile.
# Changing this one value moves both; the second SUPER_ADMIN (Argenis) stays
# hardcoded in UserSeeder. CompanyDataSeeder falls back to the first active
# SUPER_ADMIN when this address does not exist.
SEED_COMPANY_OWNER_EMAIL=aquashieldrestoration@gmail.com

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Session hardening -- OWASP baseline 15.5 (see .opencode/skills/owasp/SKILL.md 17).
# Local runs over plain http, so SESSION_SECURE_COOKIE must stay FALSE here or the
# browser will never send the cookie and login silently breaks.
# PRODUCTION: SESSION_SECURE_COOKIE=true  (config/session.php:174 has NO default)
#             SESSION_ENCRYPT=true       (encrypts the cookie payload at rest)
#             SESSION_DOMAIN=null        (host-only: required for the __Host- prefix)
#             SESSION_COOKIE=__Host-aquashield-session
# The __Host- prefix is rejected unless the cookie is Secure, Path=/ and has no
# Domain attribute -- that is the hardening, so it cannot be set locally.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_EXPIRE_ON_CLOSE=false
SESSION_PARTITIONED_COOKIE=false
# SESSION_CONNECTION=
# SESSION_STORE=
# SESSION_TABLE=sessions

# Account lockout + idle warning (config/auth.php -> hardening).
# 5 wrong passwords lock the account for 60 minutes; the form warns after
# 5 minutes of inactivity and signs out if the dialog is ignored for 60 s.
# Set AUTH_IDLE_WARN_MINUTES=3 for the stricter product variant.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=60
AUTH_IDLE_WARN_MINUTES=5
AUTH_IDLE_GRACE_SECONDS=60

# OTP / passkeys (Fortify + pragmarx/google2fa + laravel/passkeys).
OTP_ENABLED=true
OTP_LIFETIME=0
OTP_KEEP_ALIVE=true
OTP_THROW_EXCEPTION=true
# PASSKEYS_USER_HANDLE_SECRET=  # defaults to APP_KEY; set only to rotate independently

# Security headers (config/security.php + config/csp.php). HSTS is emitted only
# over HTTPS, so it is safe to leave enabled locally. CSP is nonce-based.
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_SUBDOMAINS=true
HSTS_PRELOAD=false
PERMISSIONS_POLICY="camera=(), microphone=(), geolocation=()"
CSP_ENABLED=true
CSP_NONCE_ENABLED=true
CSP_ENABLED_WHILE_HOT_RELOADING=false
# CSP_REPORT_URI=
# CSP_REPORT_ONLY_URI=
# CSP_REPORT_TO=
# CSP_REPORT_ONLY_TO=
COOKIE_CONSENT_ENABLED=true

# Coarse city/country shown in security emails. Set false to skip the lookup.
GEOLOCATION_ENABLED=true
GEOLOCATION_ENDPOINT=https://ipwho.is
GEOLOCATION_CONNECT_TIMEOUT=1
GEOLOCATION_TIMEOUT=2
#GEOLOCATION_ENABLED=false

# argon2id is the default driver in config/hashing.php. Laravel's skeleton ships
# bcrypt; without that published config the app runs on the weaker hash.
# BCRYPT_ROUNDS (line 16) only applies if you switch HASH_DRIVER back to bcrypt.
HASH_DRIVER=argon2id

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids
# Both must stay above RunDatabaseBackupJob::$timeout (900 s): 960.
# REDIS_QUEUE_RETRY_AFTER=960
# DB_QUEUE_RETRY_AFTER=960

CACHE_STORE=database
# CACHE_PREFIX=

# Availability-rule resource bounds and write throttling.
AVAILABILITY_RULES_MAX_ACTIVE=50
AVAILABILITY_RULES_MAX_PER_WEEKDAY=10
AVAILABILITY_RULES_MAX_TRASHED_READ=100
AVAILABILITY_RULES_THROTTLE_PER_MINUTE=20

MEMCACHED_HOST=127.0.0.1

# Herd's PHP 8.6 build ships no php_redis.dll; Predis is pure PHP and already required.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local development logs mail; production uses Resend (MAIL_MAILER=resend).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Resend transactional mail (required when MAIL_MAILER=resend).
RESEND_API_KEY=

# Database backups (spatie/laravel-backup v10). `backup:run --only-db` runs at
# 02:30 and `backup:clean` at 03:30 (see routes/console.php). Retention is the
# package's grandfather-father-son policy: keep everything for 7 days, then one
# per day for 16 days, one per week for 8 weeks, one per month for 4 months and
# one per year for 2 years. Tune without editing code.
BACKUP_ARCHIVE_PASSWORD=
BACKUP_VERIFY_BACKUP=true
BACKUP_KEEP_ALL_DAYS=7
BACKUP_KEEP_DAILY_DAYS=16
BACKUP_KEEP_WEEKLY_WEEKS=8
BACKUP_KEEP_MONTHLY_MONTHS=4
BACKUP_KEEP_YEARLY_YEARS=2
BACKUP_MAX_STORAGE_MB=5000

# The panel's delete moves an archive to quarantine, not to /dev/null.
# `backups:purge-quarantine` destroys it after this window (days).
BACKUP_QUARANTINE_RETAIN_DAYS=30
BACKUP_QUARANTINE_DIRECTORY=.backups-quarantine

# Where failure/health notifications go. Empty falls back to MAIL_FROM_ADDRESS.
BACKUP_NOTIFICATION_MAIL_TO=

# Audit trail retention (activitylog:clean --force, monthly). Defaults to 2555
# days = 7 years, the longest common US window (SOX/GLBA 7y, HIPAA 6y, PCI 12m).
# Lower it only with counsel; the cleanup schedule enforces it.
ACTIVITYLOG_CLEAN_AFTER_DAYS=2555

# Where a failed monthly retention run is reported. Falls back to
# BACKUP_NOTIFICATION_MAIL_TO, then MAIL_FROM_ADDRESS.
ACTIVITYLOG_ALERT_EMAIL=

# Cloudflare R2 (StoragePort). Avatars and business uploads use this disk.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=
R2_DEFAULT_REGION=auto
R2_USE_PATH_STYLE_ENDPOINT=true

# Google OAuth (Socialite). Create OAuth credentials in Google Cloud Console
# and register {APP_URL}/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/auth/google/callback

# Google Maps JavaScript API + Places API (New), used by the reusable address
# autocomplete field on the profile screen. Enable BOTH APIs in Google Cloud
# and restrict this browser key by HTTP referrer (http://localhost:8000/* in
# local, the production origin in prod). It is not a server secret.
GOOGLE_MAPS_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

INERTIA_SSR_ENABLED=false

# Dev tooling must stay off outside local. Telescope is enabled by default in
# config/telescope.php; Scramble and Debugbar default to APP_DEBUG.
TELESCOPE_ENABLED=false
# SCRAMBLE_DEV_TOOLS=false
# DEBUGBAR_ENABLED=false
# INERTIA_DEVTOOLS_ENABLED=false

# LeadAppointment — lead intake, scheduling and Google Calendar sync.
LEAD_DEDUPE_WINDOW_DAYS=30
LEAD_APPOINTMENT_DEFAULT_REGION=houston
SMS_CONSENT_VERSION=sms-v1-2026-11-20
HONEYPOT_ENABLED=true
GOOGLE_CALENDAR_SYNC=false
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_AUTH_PROFILE=service_account
# GOOGLE_CALENDAR_IMPERSONATE=
META_GRAPH_VERSION=v27.0
META_GRAPH_URL=https://graph.facebook.com
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=

# ---- Tavily (research / web search) ----
TAVILY_API_KEY=
TAVILY_SEARCH_URL=https://api.tavily.com/search
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=5

FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1
FIRECRAWL_TIMEOUT=30
FIRECRAWL_MAX_AGE=172800000
