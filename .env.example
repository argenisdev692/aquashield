APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Session hardening -- OWASP baseline 15.5 (see .opencode/skills/owasp/SKILL.md 17).
# Local runs over plain http, so SESSION_SECURE_COOKIE must stay FALSE here or the
# browser will never send the cookie and login silently breaks.
# PRODUCTION: SESSION_SECURE_COOKIE=true  (config/session.php:174 has NO default)
#             SESSION_ENCRYPT=true       (encrypts the cookie payload at rest)
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# argon2id is the default driver in config/hashing.php. Laravel's skeleton ships
# bcrypt; without that published config the app runs on the weaker hash.
# BCRYPT_ROUNDS (line 16) only applies if you switch HASH_DRIVER back to bcrypt.
HASH_DRIVER=argon2id

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Google OAuth (Socialite). Create OAuth credentials in Google Cloud Console
# and register {APP_URL}/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/auth/google/callback

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

INERTIA_SSR_ENABLED=false

# PrimeUI license key (Community tier is free - https://primeui.dev/licenses/community).
# Without it PrimeVue 5 logs "[PrimeUI] PrimeUI license is not configured." and shows a banner.
VITE_PRIMEUI_LICENSE=
